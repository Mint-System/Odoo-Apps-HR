<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="hr_employee_report" model="ir.actions.report">
        <field name="name">Attendance Report</field>
        <field name="model">hr.employee</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hr_employee_attendance_report.hr_employee</field>
        <field name="report_file">hr_employee_attendance_report.hr_employee</field>
        <field name="print_report_name">'Attendance Report'</field>
        <field name="binding_model_id" ref="hr.model_hr_employee" />
        <field name="binding_type">report</field>
    </record>

    <template id="hr_employee_attendance_report.hr_employee">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="hr_employee_attendance_report.hr_employee_template" />
            </t>
        </t>
    </template>


    <template id="hr_employee_template">
        <t t-call="web.internal_layout">
            <div class="page">
                <t
                    t-set="fixed_work_hours"
                    t-value="summary[doc.id]['fixed_work_hours']"
                />

                <h5 class="attendance-report">Attendance Report</h5>

                <p><span class="light-text">Employee:</span> <span t-out="doc.name" /></p>
                <p><span class="light-text">From:</span> <span
                        t-out="dates[doc.id]['start_date']"
                        t-options="{'widget': 'date'}"
                    /> 
                    <span class="light-text">Until: </span><span
                        t-out="dates[doc.id]['end_date']"
                        t-options="{'widget': 'date'}"
                    /></p>

                
                <table
                    class="table table-sm attendances-table"
                    name="attendances_table"
                    style="width: 100%; font-size:7pt"
                >
                    <thead>
                        <tr>
                            <th name="th_date">
                                Date
                            </th>
                            <th name="th_weekday" t-if="show_weekdays">
                                WKDY
                            </th>
                            <th name="th_planned_hours" t-if="fixed_work_hours">
                                h planned
                            </th>
                            <th name="th_leave_hours" t-if="fixed_work_hours">
                                h absent
                            </th>
                            <th name="th_leave_types" t-if="fixed_work_hours">
                                Leave Types
                            </th>
                            <th name="th_worked_hours">
                                h present
                            </th>
                            <th name="th_diff_hours" t-if="show_diff_hours">
                                +/-
                            </th>
                            <th name="th_time_stamps" t-if="fixed_work_hours">
                                Time Stamps
                            </th>
                            <th name="th_overtime" t-if="fixed_work_hours">
                                h +/-
                            </th>
                        </tr>
                    </thead>
                    <tbody class="attendances-table">
                        <t t-foreach="attendances[doc.id]" t-as="attendance">

                            <tr
                                t-attf-style="background-color: #{attendance['background_color']};"
                            >
                                <td id="date">
                                    <t
                                        t-out="attendance['date']"
                                        t-options="{'widget': 'date'}"
                                    />
                                </td>
                                <td id="weekday" t-if="show_weekdays">
                                    <t t-out="attendance['weekday']" />
                                </td>
                                <td id="planned_hours" t-if="fixed_work_hours">
                                    <t t-out="attendance['planned_hours']" />
                                </td>
                                <td id="leave_hours" t-if="fixed_work_hours">
                                    <t t-out="attendance['leave_hours']" />
                                </td>
                                <td id="leave_types" t-if="fixed_work_hours">
                                    <t t-out="attendance['leave_types']" />
                                </td>
                                <td id="worked_hours">
                                    <t t-out="attendance['worked_hours']" />
                                </td>
                                <td id="diff_hours" t-if="show_diff_hours">
                                    <t t-out="attendance['diff_hours']" />
                                </td>
                                <td id="time_stamps" t-if="fixed_work_hours" style="white-space:nowrap;">
                                    <t t-out="attendance['time_stamps']" />
                                </td>
                                <td id="overtime" t-if="fixed_work_hours">
                                    <t t-out="attendance['overtime']" />
                                </td>
                            </tr>

                        </t>
                    </tbody>
                </table>

                <div id="summary" class="clearfix" name="summary">
                    <div
                        t-attf-class="#{'col-6' if report_type != 'html' else 'col-sm-7 col-md-6'} ms-auto"
                    >
                        <style>
                            table.summary_table th {
                                text-align: left;
                            }
                            table.summary_table td {
                                text-align: right;
                            }
                        </style>
                        <table
                            class="table table-sm summary_table"
                            name="summary_table"
                        >

                            <tbody class="summary_table">
                                <tr t-if="fixed_work_hours">
                                    <th name="th_planned_hours">
                                        Planned Hours
                                    </th>
                                    <td id="planned_hours">
                                        <t t-out="summary[doc.id]['planned_hours']" />
                                    </td>
                                </tr>
                                <tr t-if="fixed_work_hours">
                                    <th name="th_leave_hours">
                                        Leave Hours
                                    </th>
                                    <td id="leave_hours">
                                        <t t-out="summary[doc.id]['leave_hours']" />
                                    </td>
                                </tr>
                                <tr>
                                    <th name="th_worked_hours">
                                        Worked Hours
                                    </th>
                                    <td id="worked_hours">
                                        <t t-out="summary[doc.id]['worked_hours']" />
                                    </td>
                                </tr>
                                <tr t-if="fixed_work_hours">
                                    <th name="th_overtime">
                                        Overtime
                                    </th>
                                    <td id="overtime">
                                        <t t-out="summary[doc.id]['overtime']" />
                                    </td>
                                </tr>
                                <!-- <tr t-if="fixed_work_hours">
                                    <th name="th_overtime_paid_out">
                                        Overtime (paid out)
                                    </th>
                                    <td id="overtime_paid_out" class="text-right">
                                        <t t-out="summary[doc.id]['overtime_paid_out']" />
                                    </td>
                                </tr> -->
                                <tr t-if="fixed_work_hours">
                                    <th name="th_overtime_total">
                                        Overtime Total
                                    </th>
                                    <td id="overtime_total">
                                        <t t-out="summary[doc.id]['overtime_total']" />
                                    </td>
                                </tr>
                                 <!-- <tr t-if="fixed_work_hours">
                                    <th name="th_overtime_total">
                                        Overtime Paid Out Total
                                    </th>
                                    <td id="overtime_paid_out_total" class="text-right">
                                        <t t-out="summary[doc.id]['overtime_paid_out_total']" />
                                    </td>
                                </tr> -->
                            </tbody>
                        </table>
                    </div>
                </div>

                <t t-if="fixed_work_hours">
                    <h5>Leave Allocations</h5>

                    <table
                        class="table table-sm allocations_table"
                        name="allocations_table"
                    >
                        <thead>
                            <tr>
                                <th name="th_description" class="text-start">
                                    Description
                                </th>
                                <th name="th_leave_type" class="text-start">
                                    Time Off Type
                                </th>
                                <th name="th_allocation" class="text-end">
                                    Allocation
                                </th>
                                <th name="th_leaves_taken" class="text-end">
                                    Leaves Taken
                                </th>
                                <th name="th_remaining_leaves" class="text-end">
                                    Remaining
                                </th>
                            </tr>
                        </thead>
                        <tbody class="leaves_table">
                            <t t-foreach="leave_allocations[doc.id]" t-as="allocation">

                                <tr>
                                    <td id="description" class="text-start">
                                        <t t-out="allocation.name" />
                                    </td>
                                    <td id="leave_type" class="text-start">
                                        <t t-out="allocation.holiday_status_id.name" />
                                    </td>
                                    <td id="allocation" class="text-end">
                                        <t t-out="allocation.duration_display" />
                                    </td>
                                    <td id="leaves_taken" class="text-end">
                                        <t t-out="round(allocation.leaves_taken, 2)" />
                                    </td>
                                    <td id="remaining_leaves" class="text-end">
                                        <t
                                            t-out="allocation.remaining_leaves_display"
                                        />
                                    </td>
                                </tr>

                            </t>
                        </tbody>
                    </table>
                </t>

                <t t-if="fixed_work_hours">
                <br/>
                    <h5>Leave Allocations V2</h5>

                    <div id="summary_enhanced" class="clearfix" name="summary_enhanced">
                        <div>
                            <style>
                                table.summary_table_v2 th {
                                    text-align: left;
                                }
                                table.summary_table_v2 td {
                                    text-align: left;
                                }
                            </style>
                            <table
                                class="table table-sm summary_table_v2"
                                name="summary_table_v2"
                            >

                                <tbody class="summary_table_v2">
                                    <tr t-if="fixed_work_hours">
                                        <th name="th_balance">
                                            Balance
                                        </th>
                                        <th name="th_period">
                                            Period
                                        </th>
                                        <th name="th_overtime">
                                            Overtime
                                        </th>
                                        <t
                                            t-foreach="summary[doc.id]['leaves']"
                                            t-as="item"
                                        >
                                            <th name="th_leave_key">
                                                <t t-out="item" />
                                            </th>
                                        </t>
                                    </tr>
                                    <tr t-if="fixed_work_hours">
                                        <td id="active_leaves">
                                            Active Leaves
                                        </td>
                                        <td id="current_period">
                                            <span
                                                t-out="dates[doc.id]['start_date']"
                                                t-options="{'widget': 'date'}"
                                            />
                                            <span
                                                t-out="dates[doc.id]['end_date']"
                                                t-options="{'widget': 'date'}"
                                            />
                                        </td>
                                        <td id="overtime">
                                            <t t-out="summary[doc.id]['overtime']" />
                                        </td>
                                        <t
                                            t-foreach="summary[doc.id]['leaves'].values()"
                                            t-as="leave_value"
                                        >
                                            <td id="leave">
                                            <t t-out="leave_value" />
                                            </td>
                                        </t>
                                    </tr>

                                </tbody>
                            </table>
                        </div>
                    </div>

                </t>


            </div>

        </t>
    </template>

</odoo>
