<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="hr_attendance_view_form" model="ir.ui.view">
        <field name="name">hr.attendance.form.inherit.overtime.leave.type</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.hr_attendance_view_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='linked_overtime_ids']/list/field[@name='duration']"
                position="before"
            >
                <field name="overtime_leave_type_id" optional="show" />
            </xpath>
            <xpath expr="//field[@name='validated_overtime_hours']" position="after">
                <field
                    name="weekly_overtime_hours"
                    widget="float_time"
                    invisible="not weekly_overtime_hours"
                />
            </xpath>
        </field>
    </record>
    <record id="view_attendance_tree" model="ir.ui.view">
        <field name="name">hr.attendance.list.inherit.overtime.leave.type</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.view_attendance_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='validated_overtime_hours']" position="after">
                <field name="weekly_overtime_hours" optional="hide" widget="float_time" />
            </xpath>
        </field>
    </record>
    <record id="view_attendance_tree_management" model="ir.ui.view">
        <field name="name">hr.attendance.list.management.inherit.overtime.leave.type</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.view_attendance_tree_management" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='validated_overtime_hours']" position="after">
                <field name="weekly_overtime_hours" widget="float_time" />
            </xpath>
        </field>
    </record>
</odoo>
