<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="hr_attendance_overtime_rule_view_form" model="ir.ui.view">
        <field name="name">hr_holidays_attendance_overtime.hr_attendance_overtime_rule_view_form</field>
        <field name="model">hr.attendance.overtime.rule</field>
        <field
            name="inherit_id"
            ref="hr_holidays_attendance.hr_attendance_overtime_rule_view_form"
        />
        <field name="arch" type="xml">
            <field name="compensable_as_leave" position="after">
                <field
                    name="leave_type_id"
                    invisible="not compensable_as_leave"
                    options="{'no_create': True}"
                />
                <field
                    name="max_extra_hours"
                    widget="float_time"
                    invisible="base_off != 'quantity' or not compensable_as_leave"
                />
            </field>
        </field>
    </record>
</odoo>
