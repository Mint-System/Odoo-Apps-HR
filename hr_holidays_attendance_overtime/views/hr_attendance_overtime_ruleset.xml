<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="hr_attendance_overtime_ruleset_view_form" model="ir.ui.view">
        <field name="name">hr_holidays_attendance_overtime.hr_attendance_overtime_ruleset_view_form</field>
        <field name="model">hr.attendance.overtime.ruleset</field>
        <field
            name="inherit_id"
            ref="hr_attendance.hr_attendance_overtime_ruleset_view_form"
        />
        <field name="arch" type="xml">
            <sheet position="inside">
                <div class="oe_button_box" name="button_box">
                    <button
                        name="action_open_employees"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-users"
                        invisible="not employee_count"
                    >
                        <field
                            name="employee_count"
                            widget="statinfo"
                            string="Employees"
                        />
                    </button>
                </div>
            </sheet>
        </field>
    </record>
</odoo>
