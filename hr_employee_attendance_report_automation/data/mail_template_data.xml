<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="mail_template_attendance_report" model="mail.template">
        <field name="name">Attendance Report - Monthly</field>
        <field name="model_id" ref="model_hr_employee_report_automation" />
        <field name="subject">Monthly Attendance Report - {{ object.name }}</field>
        <field name="email_from">{{ object.company_id.email or '' }}</field>
        <field name="email_to">{{ object.recipient_ids.mapped('email') | join(',') }}</field>
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">
                <p style="margin: 0px; padding: 0px; font-size: 13px;">
                    Dear Recipient,<br /><br />
                    Please find attached the monthly attendance report for <strong>{{ object.name }}</strong>.<br /><br />
                    Report Period: From {{ object.last_period_start or 'N/A' }} to {{ object.last_period_end or 'N/A' }}<br /><br />
                    Best regards,<br />
                    {{ object.company_id.name or '' }}
                </p>
            </div>
        </field>
    </record>
</odoo>
