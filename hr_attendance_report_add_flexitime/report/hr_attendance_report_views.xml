<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record
        id="hr_attendance_report_add_flexitime.hr_attendance_report_view_pivot"
        model="ir.ui.view"
    >
        <field name="name">hr.attendance.report.view.pivot.inherit.planned</field>
        <field name="model">hr.attendance.report</field>
        <field name="inherit_id" ref="hr_attendance.hr_attendance_report_view_pivot" />
        <field name="arch" type="xml">
            <xpath expr="//pivot" position="inside">
                <field name="planned_hours" type="measure" widget="float_time" />
                <field name="diff_hours" type="measure" widget="float_time" />
            </xpath>
        </field>
    </record>
</odoo>
