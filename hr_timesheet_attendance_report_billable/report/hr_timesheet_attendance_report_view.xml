<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_hr_timesheet_attendance_report_pivot" model="ir.ui.view">
        <field
            name="name"
        >hr_timesheet_attendance_report_billable.view_hr_timesheet_attendance_report_pivot</field>
        <field name="model">hr.timesheet.attendance.report</field>
        <field
            name="inherit_id"
            ref="hr_timesheet_attendance.view_hr_timesheet_attendance_report_pivot"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='total_timesheet']" position="after">
                <field
                    name="billable_timesheet"
                    type="measure"
                    widget="timesheet_uom"
                />
                <field
                    name="non_billable_timesheet"
                    type="measure"
                    widget="timesheet_uom"
                />
                <field
                    name="courtesy"
                    type="measure"
                    widget="timesheet_uom"
                />
                <field
                    name="internal_timesheet"
                    type="measure"
                    widget="timesheet_uom"
                />
                <field name="billable_timesheet_ratio" type="measure" widget="percentage"/>
                <field name="non_billable_timesheet_ratio" type="measure" widget="percentage"/>
                <field name="courtesy_ratio" type="measure" widget="percentage"/>
                <field name="internal_timesheet_ratio" type="measure" widget="percentage"/>
            </xpath>
        </field>
    </record>

    <record id="hr_timesheet.menu_timesheets_reports" model="ir.ui.menu">
        <field
            name="groups_id"
            eval="[(4, ref('hr_timesheet.group_hr_timesheet_user'))]"
        />
    </record>
</odoo>
