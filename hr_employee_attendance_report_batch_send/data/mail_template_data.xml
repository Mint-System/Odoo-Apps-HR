<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">
        <record id="email_template_attendance_report" model="mail.template">
            <field name="name">Attendance Report Email</field>
            <field name="model_id" ref="hr.model_hr_employee" />
            <field name="email_from">
                {{ user.email_formatted }}
            </field>
            <field name="email_to">
                {{ object.work_email }}
            </field>
            <field name="subject">
                Attendance Report - {{ object.name }}
            </field>

            <!-- Body -->
            <field name="body_html" type="html">
                <table
                    border="0"
                    cellpadding="0"
                    cellspacing="0"
                    style="width:100%; margin:0px auto;"
                >
                    <tbody>
                        <tr>
                            <td valign="top" style="text-align: left; font-size: 14px;">
                        Dear <t t-esc="object.name" />,<br /><br />
                        Please find attached your attendance report for<br />
                        <t t-esc="ctx.get('date_from')" /> to <t
                                t-esc="ctx.get('date_until')"
                            />
                        <br /><br />
                        Best regards,<br />
                        The HR Team
                        </td>
                        </tr>
                    </tbody>
                </table>
            </field>

            <field name="auto_delete" eval="True" />
        </record>
    </data>
</odoo>
