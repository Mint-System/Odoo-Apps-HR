<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="hr_employee_attendance_report_balances.hr_employee_template" inherit_id="hr_employee_attendance_report.hr_employee_template">

        <!-- Add overtime table before attendances table -->
        <xpath expr="//table[@name='table_attendance']" position="before">
            <table
                    class="table table-sm overtime_balance_table"
                    name="overtime_balance_table"
                >
                <tbody>
                    <tr>
                        <th id="planned" class="text-start">
                        planned [h]
                        </th>
                        <th id="worked" class="text-start">
                        worked [h]
                        </th>
                        <th id="overtime_balance" class="text-start">
                        Flexitime Month [h]
                        </th>
                        <th id="overtime_two_months_ago" class="text-start">
                        Flexitime Previous Month [h]
                        </th>
                        <th id="overtime_last_month" class="text-start">
                        Flexitime [h]
                        </th>
                    </tr>

                    <tr>
                        <td id="planned_value" class="text-start">
                            <t
                                t-out="summary[doc.id]['planned_hours']"
                            /> 

                        </td>
                        <td id="worked_value" class="text-start">
                            <t
                                t-out="summary[doc.id]['worked_hours']"
                            /> 

                        </td>
                        <td id="overtime_balance_value" class="text-start">
                            <t
                                t-out="summary[doc.id]['overtime_balance']"
                            /> 

                        </td>
                        <td id="overtime_two_months_ago_value" class="text-start">
                            <t
                                t-out="summary[doc.id]['overtime_two_months_ago']"
                            /> 

                        </td>
                         <td id="overtime_last_month_value" class="text-start">
                            <t
                                t-out="summary[doc.id]['overtime_last_month']"
                            /> 

                        </td>

                    </tr>
                </tbody>
            </table>
        </xpath>
    </template>
</odoo>
