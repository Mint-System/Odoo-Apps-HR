<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="cron_hr_employee_attendance_report_automation" model="ir.cron">
        <field name="name">Generate and Send Monthly Attendance Reports</field>
        <field name="model_id" ref="model_hr_employee_report_automation" />
        <field name="state">code</field>
        <field name="code">model.search([('active', '=', True)]).action_generate_and_send_reports()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">months</field>
        <field name="nextcall" eval="(datetime.now() + relativedelta(months=1, day=1, hour=2, minute=0)).strftime('%Y-%m-%d %H:%M:%S')" />
        <field name="active">False</field>
    </record>
</odoo>
