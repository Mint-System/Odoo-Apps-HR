<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="hr_employee_enhanced_report" model="ir.actions.report">
        <field name="name">Attendance Report Enhanced</field>
        <field name="model">hr.employee</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hr_employee_attendance_report.hr_employee_enhanced</field>
        <field name="report_file">hr_employee_attendance_report.hr_employee_enhanced</field>
        <field name="print_report_name">'Attendance Report Plus'</field>
        <field name="binding_model_id" ref="hr.model_hr_employee" />
        <field name="binding_type">report</field>
    </record>

    <template id="hr_employee_attendance_report.hr_employee_enhanced">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="hr_employee_attendance_report.hr_employee_enhanced_template" />
            </t>
        </t>
    </template>
   

    <template id="hr_employee_enhanced_template">
        <t t-call="web.internal_layout">
            <div class="page">
                <t
                    t-set="fixed_work_hours"
                    t-value="summary[doc.id]['fixed_work_hours']"
                />

                <h1>Attendance Report Enhanced</h1>

                <p>Employee: <span t-out="doc.name" /></p>
                <p>From: <span
                        t-out="dates[doc.id]['start_date']"
                        t-options="{'widget': 'date'}"
                    /><br />
                    Until: <span
                        t-out="dates[doc.id]['end_date']"
                        t-options="{'widget': 'date'}"
                    /></p>

                <style>
                    table.attendances_table th:not(:first-child),
                    table.attendances_table td:not(:first-child) {
                    text-align: right;
                    }
                </style>
                <table
                    class="table table-sm attendances_table"
                    name="attendances_table"
                >
                    <thead>
                        <tr>
                            <th name="th_date">
                                Date
                            </th>
                            <th name="th_planned_hours" t-if="fixed_work_hours">
                                Planned
                            </th>
                            <th name="th_leave_hours" t-if="fixed_work_hours">
                                Leaves
                            </th>
                             <th name="th_leave_type" t-if="fixed_work_hours">
                                Leave Type
                            </th>
                            <th name="th_diff_hours" t-if="fixed_work_hours">
                                +/-
                            </th>
                            <th name="th_time_stamps" t-if="fixed_work_hours">
                                Time Stamps
                            </th>
                            <th name="th_worked_hours">
                                Worked Hours
                            </th>
                            <th name="th_overtime" t-if="fixed_work_hours">
                                Overtime
                            </th>
                        </tr>
                    </thead>
                    <tbody class="attendances_table">
                        <t t-foreach="attendances[doc.id]" t-as="attendance">

                            <tr
                                t-attf-style="background-color: #{attendance['background_color']};"
                            >
                                <td id="date">
                                    <t
                                        t-out="attendance['date']"
                                        t-options="{'widget': 'date'}"
                                    />
                                </td>
                                <td id="planned_hours" t-if="fixed_work_hours">
                                    <t t-out="attendance['planned_hours']" />
                                </td>
                                <td id="leave_hours" t-if="fixed_work_hours">
                                    <t t-out="attendance['leave_hours']" />
                                </td>
                                <td id="leave_type" t-if="fixed_work_hours">
                                    <t t-out="attendance['leave_type']" />
                                </td>
                                <td id="diff_hours" t-if="fixed_work_hours">
                                    <t t-out="attendance['diff_hours']" />
                                </td>
                                <td id="time_stamps" t-if="fixed_work_hours">
                                    <t t-out="attendance['time_stamps']" />
                                </td>
                                <td id="worked_hours">
                                    <t t-out="attendance['worked_hours']" />
                                </td>
                                <td id="overtime" t-if="fixed_work_hours">
                                    <t t-out="attendance['overtime']" />
                                </td>
                            </tr>

                        </t>
                    </tbody>
                </table>

                <div id="summary" class="clearfix" name="summary">
                    <div
                        t-attf-class="#{'col-6' if report_type != 'html' else 'col-sm-7 col-md-6'} ms-auto"
                    >
                        <style>
                            table.summary_table th {
                                text-align: left;
                            }
                            table.summary_table td {
                                text-align: right;
                            }
                        </style>
                        <table
                            class="table table-sm summary_table"
                            name="summary_table"
                        >

                            <tbody class="summary_table">
                                <tr t-if="fixed_work_hours">
                                    <th name="th_planned_hours">
                                        Planned Hours
                                    </th>
                                    <td id="planned_hours">
                                        <t t-out="summary[doc.id]['planned_hours']" />
                                    </td>
                                </tr>
                                <tr t-if="fixed_work_hours">
                                    <th name="th_leave_hours">
                                        Leave Hours
                                    </th>
                                    <td id="leave_hours">
                                        <t t-out="summary[doc.id]['leave_hours']" />
                                    </td>
                                </tr>
                                <tr>
                                    <th name="th_worked_hours">
                                        Worked Hours
                                    </th>
                                    <td id="worked_hours">
                                        <t t-out="summary[doc.id]['worked_hours']" />
                                    </td>
                                </tr>
                                <tr t-if="fixed_work_hours">
                                    <th name="th_overtime">
                                        Overtime
                                    </th>
                                    <td id="overtime">
                                        <t t-out="summary[doc.id]['overtime']" />
                                    </td>
                                </tr>
                                <tr t-if="fixed_work_hours">
                                    <th name="th_overtime_total">
                                        Overtime Total
                                    </th>
                                    <td id="overtime_total">
                                        <t t-out="summary[doc.id]['overtime_total']" />
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <t t-if="fixed_work_hours">
                    <h2>Leave Allocations V1</h2>

                    <div id="summary_enhanced" class="clearfix" name="summary_enhanced">
                        <div>
                            <style>
                                table.summary_table_enhanced th {
                                    text-align: left;
                                }
                                table.summary_table_enhanced td {
                                    text-align: left;
                                }
                            </style>
                            <table
                                class="table table-sm summary_table_enhanced"
                                name="summary_table_enhanced"
                            >

                                <tbody class="summary_table_enhanced">
                                    <tr t-if="fixed_work_hours">
                                        <th name="th_balance">
                                            Balance
                                        </th>
                                        <th name="th_period">
                                            Period
                                        </th>
                                        <th name="th_overtime">
                                            Overtime
                                        </th>
                                        <t t-foreach="summary[doc.id]['leaves']" t-as="item">
                                            <th name="th_leave_key">
                                                <t t-out="item"/>
                                            </th>
                                        </t>
                                    </tr>
                                    <tr t-if="fixed_work_hours">
                                        <td id="active_leaves">
                                            Active Leaves
                                        </td>
                                        <td id="current_period">
                                            <span
                                                t-out="dates[doc.id]['start_date']"
                                                t-options="{'widget': 'date'}"
                                            />
                                            <span
                                                t-out="dates[doc.id]['end_date']"
                                                t-options="{'widget': 'date'}"
                                            />
                                        </td>
                                        <td id="overtime">
                                            <t t-out="summary[doc.id]['overtime']" />
                                        </td>
                                        <t t-foreach="summary[doc.id]['leaves'].values()" t-as="leave_value">
                                            <td id="leave">
                                            <t t-out="leave_value" />
                                            </td>
                                        </t> 
                                    </tr>
                                    
                                </tbody>
                            </table>
                        </div>
                    </div>

                </t>


                <t t-if="fixed_work_hours">
                    <h2>Leave Allocations V2</h2>

                    <table
                        class="table table-sm allocations_table"
                        name="allocations_table"
                    >
                        <thead>
                            <tr>
                                <th name="th_description" class="text-start">
                                    Description
                                </th>
                                <th name="th_leave_type" class="text-start">
                                    Time Off Type
                                </th>
                                <th name="th_allocation" class="text-end">
                                    Allocation
                                </th>
                                <th name="th_leaves_taken" class="text-end">
                                    Leaves Taken
                                </th>
                                <th name="th_remaining_leaves" class="text-end">
                                    Remaining
                                </th>
                            </tr>
                        </thead>
                        <tbody class="leaves_table">
                            <t t-foreach="leave_allocations[doc.id]" t-as="allocation">

                                <tr>
                                    <td id="description" class="text-start">
                                        <t t-out="allocation.name" />
                                    </td>
                                    <td id="leave_type" class="text-start">
                                        <t t-out="allocation.holiday_status_id.name" /> (<t t-out="allocation.holiday_status_id.code" />)
                                    </td>
                                    <td id="allocation" class="text-end">
                                        <t t-out="allocation.duration_display" />
                                    </td>
                                    <td id="leaves_taken" class="text-end">
                                        <t t-out="round(allocation.leaves_taken, 2)" />
                                    </td>
                                    <td id="remaining_leaves" class="text-end">
                                        <t
                                            t-out="allocation.remaining_leaves_display"
                                        />
                                    </td>
                                </tr>

                            </t>
                        </tbody>
                    </table>
                </t>


                   <t t-if="fixed_work_hours">
                    <h2>Leave Allocations V3</h2>

                    <table
                        class="table table-sm allocations_table"
                        name="allocations_table"
                    >
                        <thead>
                            <tr>
                                <th name="th_balance" class="text-start">
                                    Balance
                                </th>
                                <th name="th_period" class="text-start">
                                    Period
                                </th>
                                <th name="th_overtime" class="text-start">
                                    Overtime
                                </th>
                                <t t-foreach="leave_allocations_per_type[doc.id]" t-as="item">
                                    <th name="th_leave_key">
                                        <t t-out="item"/>
                                    </th>
                                </t>
                               
                            </tr>
                        </thead>
                        <tbody class="leaves_table">
                           

                                <tr>

                                     <td id="allocations">
                                            Allocations
                                    </td>
                                    <td id="ref_period">
                                        
                                    </td>
                                    <td id="allocated_overtimes">
                                        Allocated Overtimes?
                                    </td>
                                    <t t-foreach="leave_allocations_per_type[doc.id].items()" t-as="leave_item">
                                        <t t-set="leave_type" t-value="leave_item[0]"/>
                                        <t t-set="leave" t-value="leave_item[1]"/>
                                        <td id="leave">
                                          <t t-out="leave['number_of_days']"/>
                                        </td>
                                    </t> 
                                </tr>

                                <tr>

                                     <td id="active_leaves">
                                            Active Leaves
                                    </td>
                                    <td id="current_period">
                                        <span
                                            t-out="dates[doc.id]['start_date']"
                                            t-options="{'widget': 'date'}"
                                        />
                                        <span
                                            t-out="dates[doc.id]['end_date']"
                                            t-options="{'widget': 'date'}"
                                        />
                                    </td>
                                    <td id="overtime">
                                        <t t-out="summary[doc.id]['overtime']" />
                                    </td>
                                    <t t-foreach="leave_allocations_per_type[doc.id].items()" t-as="leave_item">
                                        <t t-set="leave_type" t-value="leave_item[0]"/>
                                        <t t-set="leave" t-value="leave_item[1]"/>
                                        <td id="leave">
                                          <t t-out="leave['leaves_taken']"/>
                                        </td>
                                    </t> 
                                </tr>

                                <tr>

                                     <td id="active_leaves">
                                            Remaining Leaves
                                    </td>
                                    <td id="remaining_period">
                                       
                                    </td>
                                    <td id="remaining_overtime">
                                        ?
                                    </td>
                                    <t t-foreach="leave_allocations_per_type[doc.id].items()" t-as="leave_item">
                                        <t t-set="leave_type" t-value="leave_item[0]"/>
                                        <t t-set="leave" t-value="leave_item[1]"/>
                                        <td id="leave">
                                          <t t-out="leave['remaining_leaves_days']"/>
                                        </td>
                                    </t> 
                                </tr>


                           
                        </tbody>
                    </table>
                </t>
            </div>

        </t>
    </template>

</odoo>
