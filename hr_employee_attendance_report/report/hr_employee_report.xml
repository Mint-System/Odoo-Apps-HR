<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="hr_employee_report" model="ir.actions.report">
        <field name="name">Attendance Report</field>
        <field name="model">hr.employee</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hr_employee_attendance_report.hr_employee</field>
        <field name="report_file">hr_employee_attendance_report.hr_employee</field>
        <field name="print_report_name">'Attendance Report'</field>
        <field name="binding_model_id" ref="hr.model_hr_employee" />
        <field name="binding_type">report</field>
    </record>

    <template id="hr_employee_attendance_report.hr_employee">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="hr_employee_attendance_report.hr_employee_template" />
            </t>
        </t>
    </template>


    <template id="hr_employee_template">
        <t t-call="web.internal_layout">
            <div class="page">
                <t
                    t-set="fixed_work_hours"
                    t-value="summary[doc.id]['fixed_work_hours']"
                />
                <t
                    t-set="show_paid_out"
                    t-value="summary[doc.id]['show_paid_out']"
                />

                <h5 class="attendance-report">Attendance Report</h5>

                <p><span class="light-text">Employee:</span> <span t-out="doc.name" /></p>
                <p><span class="light-text">From:</span> <span
                        t-out="dates[doc.id]['start_date']"
                        t-options="{'widget': 'date'}"
                    /> 
                    <span class="light-text">Until: </span><span
                        t-out="dates[doc.id]['end_date']"
                        t-options="{'widget': 'date'}"
                    /></p>

                
                <table
                    class="table table-sm attendances-table"
                    name="attendances_table"
                    style="width: 100%; font-size:7pt"
                >
                    <thead>
                        <tr>
                            <th name="th_date">
                                Date
                            </th>
                            <th name="th_weekday" t-if="show_weekdays">
                                WKDY
                            </th>
                            <th name="th_planned_hours" t-if="fixed_work_hours">
                                h planned
                            </th>
                            <th name="th_leave_hours" t-if="fixed_work_hours">
                                h absent
                            </th>
                            <th name="th_leave_types" t-if="fixed_work_hours">
                                Leave Types
                            </th>
                            <th name="th_worked_hours">
                                h present
                            </th>
                            <th name="th_diff_hours" t-if="show_diff_hours">
                                +/-
                            </th>
                            <th name="th_time_stamps" t-if="fixed_work_hours">
                                Time Stamps
                            </th>
                            <th name="th_overtime" t-if="show_odoo_overtimes">
                                h +/-
                            </th>
                        </tr>
                    </thead>
                    <tbody class="attendances-table">
                        <t t-foreach="attendances[doc.id]" t-as="attendance">

                            <tr
                                t-attf-style="background-color: #{attendance['background_color']};"
                            >
                                <td id="date">
                                    <span
                                        t-out="attendance['date']"
                                        t-options="{'widget': 'date'}"
                                    ></span>
                                </td>
                                <td id="weekday" t-if="show_weekdays">
                                    <span t-out="attendance['weekday']" ></span>
                                </td>
                                <td id="planned_hours" t-if="fixed_work_hours" style="text-align: right;">
                                    <t t-out="attendance['planned_hours']" t-options="{'widget': 'decimal_align', 'decimals': 2}"/>
                                </td>
                                <td text-align="right" id="leave_hours" t-if="fixed_work_hours" >
                                    <t t-out="attendance['leave_hours']" t-options="{'widget': 'decimal_align', 'decimals': 2}"/>
                                </td>
                                <td id="leave_types" t-if="fixed_work_hours" style="text-align: left;">
                                    <span t-out="attendance['leave_types']" ></span> 
                                    <span t-if="attendance['leave_types'] and attendance['missing_breaks']" >|</span>
                                    <span t-if="attendance['missing_breaks']" >Pause fehlt</span>
                                </td>
                                <td id="worked_hours" style="text-align: right;">
                                    <t t-out="attendance['worked_hours']" t-options="{'widget': 'decimal_align', 'decimals': 2}" />
                                </td>
                                <td id="diff_hours" t-if="show_diff_hours">
                                    <t t-out="attendance['diff_hours']" t-options="{'widget': 'decimal_align', 'decimals': 2}"/>
                                </td>
                                <td id="time_stamps" t-if="fixed_work_hours" style="white-space:nowrap;">
                                    <t t-out="attendance['time_stamps']" />
                                </td>
                                <td id="overtime" t-if="show_odoo_overtimes">
                                    <t t-out="attendance['overtime']" />
                                </td>
                            </tr>

                        </t>
                    </tbody>
                </table>

                <div id="summary" class="clearfix" name="summary">
                    <div
                        t-attf-class="#{'col-6' if report_type != 'html' else 'col-sm-7 col-md-6'} ms-auto"
                    >
                        <style>
                            table.summary_table th {
                                text-align: left;
                            }
                            table.summary_table td {
                                text-align: right;
                            }
                        </style>
                        <table
                            class="table table-sm summary_table"
                            name="summary_table"
                        >

                            <tbody class="summary_table">
                                <tr t-if="fixed_work_hours">
                                    <th name="th_planned_hours">
                                        Planned Hours
                                    </th>
                                    <td id="planned_hours">
                                        <t t-out="summary[doc.id]['planned_hours']" />
                                    </td>
                                </tr>
                                <tr t-if="fixed_work_hours">
                                    <th name="th_leave_hours">
                                        Leave Hours
                                    </th>
                                    <td id="leave_hours">
                                        <t t-out="summary[doc.id]['leave_hours']" />
                                    </td>
                                </tr>
                                <tr>
                                    <th name="th_worked_hours">
                                        Worked Hours
                                    </th>
                                    <td id="worked_hours">
                                        <t t-out="summary[doc.id]['worked_hours']" />
                                    </td>
                                </tr>
                                <!-- <tr t-if="fixed_work_hours">
                                    <th name="th_overtime">
                                        Overtime
                                    </th>
                                    <td id="overtime">
                                        <t t-out="summary[doc.id]['overtime_calculated']" />
                                    </td>
                                </tr> -->
                                <tr t-if="fixed_work_hours">
                                    <th name="th_overtime">
                                        +/-
                                    </th>
                                    <td id="overtime">
                                        <t t-out="summary[doc.id]['overtime_calculated']" />
                                    </td>
                                </tr>
                                <tr t-if="show_paid_out">
                                    <th name="th_overtime_paid_out">
                                        Flexitime (paid out) Hours
                                    </th>
                                    <td id="overtime_paid_out" class="text-right">
                                        <t t-out="summary[doc.id]['overtime_paid_out']" />
                                    </td>
                                </tr> 
                                <tr t-if="show_paid_out">
                                    <th name="th_overtime_without_paid_out">
                                        Flexitime Saldo Hours
                                    </th>
                                    <td id="overtime_without_paid_out">
                                        <t t-out="summary[doc.id]['overtime_without_paid_out']" />
                                    </td>
                                </tr> 
                                 <!-- <tr t-if="fixed_work_hours">
                                    <th name="th_overtime_total">
                                        Overtime Paid Out Total
                                    </th>
                                    <td id="overtime_paid_out_total" class="text-right">
                                        <t t-out="summary[doc.id]['overtime_paid_out_total']" />
                                    </td>
                                </tr> -->
                            </tbody>
                        </table>
                    </div>
                </div>

                <t t-if="show_allocation">

                 <t t-if="fixed_work_hours">
                    <div class="allocations" name="allocations">
                        <h5>Overview</h5>

                        <table
                            class="table table-sm allocations_table"
                            name="allocations_table"
                        >

                             <tr><th colspan="5" class="text-center" style="text-align: center; font-size: 12px;">Leaves <span t-out="dates[doc.id]['year']"/></th></tr>
                                <tr style="border-bottom: 1px solid black;">
                                    <th name="th_leave_type" class="text-start">
                                        Leave Type
                                    </th>
                                    <th name="th_allocation" class="text-end">
                                        Allocation <span t-out="dates[doc.id]['year']"/>
                                    </th>
                                    <th name="th_leaves_taken" class="text-end">
                                        Leaves Taken <span t-out="dates[doc.id]['year']"/>
                                    </th>
                                    <th name="th_remaining_leaves" class="text-end">
                                        Remaining <span t-out="dates[doc.id]['year']"/>
                                    </th>
                                </tr>
                                <t t-foreach="leave_allocations_per_type[doc.id]" t-as="allocation">

                                    <tr>
                                        <td id="leave_type" class="text-start">
                                            <t t-out="allocation['display_name']" />
                                        </td>
                                        <td id="allocation" class="text-end">
                                            <t t-out="allocation['number_of_days_display']" />
                                            Days
                                        </td>
                                        <td id="leaves_taken" class="text-end">
                                            <t t-out="round(allocation['leaves_taken'], 2)" />
                                            Days
                                        </td>
                                        <td id="remaining_leaves" class="text-end">
                                            <t
                                                t-out="allocation['remaining_leaves_days']"
                                            />
                                            Days
                                        </td>
                                    </tr>

                                </t>
                                <tr><th colspan="5" class="text-center" style="text-align: center; font-size: 10px;">Other Leaves <span t-out="dates[doc.id]['month_and_year']" style="margin-left: 3px;"/></th></tr>
                                <t t-foreach="summary[doc.id]['leaves_without_allocation'].items()" t-as="kv">
                                    <tr>
                                        <!-- kv is a tuple: (key, value) -->
                                        <td><t t-out="summary[doc.id]['leaves_without_allocation_descriptions'][kv[0]]"/></td>
                                        <td></td>
                                        <td class="text-end"><t t-out="kv[1]"/>
                                        Days
                                        </td>
                                    </tr>
                                </t>
                                <tr><th colspan="5" class="empty-row"></th></tr>
                         
                                <tr><th colspan="5" class="text-center" style="text-align: center; font-size: 12px;">Flexitime</th></tr>
                                <tr>
                                    <th name="th_description" class="text-start">
                                        
                                    </th>
                                    <th name="th_allocation" class="text-end">
                                        Saldo <span t-out="dates[doc.id]['end_date_of_previous_month']" t-options="{'widget': 'date'}"/>
                                    </th>
                                    <th name="th_description" class="text-end">
                                        +/- <span t-out="dates[doc.id]['month_and_year']"/>
                                    </th>
                                    <th name="th_leave_type" class="text-end">
                                        Saldo <span t-out="dates[doc.id]['end_date']" t-options="{'widget': 'date'}"/>
                                    </th>
                                   
                                </tr>
                          
                            <tbody class="flexitime_table">
                               
                                <tr>
                                    <td id="flexitime" class="text-start">
                                       Flexitime
                                    </td>
                                    <td id="flexitime-previous" class="text-end">
                                        <t t-out="summary[doc.id]['total_overtime_up_to_previous_month']" /> Hours
                                    </td>
                                    <td id="flexitime-new" class="text-end">
                                        <t t-out="summary[doc.id]['overtime_without_paid_out']" /> Hours
                                    </td>
                                    <td id="flexitime-this-month" class="text-end">
                                        <t t-out="summary[doc.id]['total_overtime_up_to_this_month']" /> Hours
                                    </td>
                                </tr>
                               
                               
                                <!-- <tr><td id="sick" class="text-start">
                                        Sick Days
                                    </td>
                                    <td id="sick_allocation" class="text-end">
                                        
                                    </td>
                                    <td id="sick_days" class="text-end">
                                        <t t-out="summary[doc.id]['sick_days']" />
                                    </td>
                                    <td id="sick_remaining" class="text-end">
                                        
                                    </td>
                                </tr> -->
                               

                              
                            </tbody>
                        </table>
                    </div>
                 </t>

                </t>


            </div>

        </t>
    </template>

</odoo>
