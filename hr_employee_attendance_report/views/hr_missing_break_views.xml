<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>

        <record id="view_hr_missing_break_tree" model="ir.ui.view">
            <field name="name">hr.missing.break.tree</field>
            <field name="model">hr.missing.break</field>
            <field name="arch" type="xml">
                <tree
                    string="Missing Breaks"
                    decoration-success="deducted == True"
                    decoration-warning="deducted == False"
                >
                    <field name="employee_id" />
                    <field name="working_day" />
                    <field name="deducted" />
                    <field name="deducted_on" optional="show" />
                </tree>
            </field>
        </record>

        <record id="view_hr_missing_break_form" model="ir.ui.view">
            <field name="name">hr.missing.break.form</field>
            <field name="model">hr.missing.break</field>
            <field name="arch" type="xml">
                <form string="Missing Break">
                    <sheet>
                        <group>
                            <field name="employee_id" />
                            <field name="working_day" />
                            <field name="deducted" readonly="1" />
                            <field name="deducted_on" readonly="1" />
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_hr_missing_break" model="ir.actions.act_window">
            <field name="name">Missing Breaks</field>
            <field name="res_model">hr.missing.break</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem
            id="menu_hr_missing_break"
            name="Missing Breaks"
            parent="hr_attendance.menu_hr_attendance_root"
            action="action_hr_missing_break"
            sequence="20"
        />

    </data>
</odoo>
